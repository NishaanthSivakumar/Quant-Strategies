# ============================================================
# Data files — never commit large/raw market data
# ============================================================
data/raw/
data/processed/
data/cache/
*.parquet
*.feather
*.h5
*.hdf5
*.pickle
*.pkl

# Large CSVs — but allow small sample/result CSVs inside results/ folders
*.csv
!**/results/*.csv
!**/sample/*.csv

# ============================================================
# Outputs — keep results PNGs in repo (small, useful for READMEs)
# but ignore scratch/ and tmp/ directories
# ============================================================
scratch/
tmp/
*.log

